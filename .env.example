# Mapbox public token (pk.*) — https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Set to 1 in simulator to use a mock GPS loop
EXPO_PUBLIC_MOCK_GPS=1

# Supabase — https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In — Google Cloud Console OAuth 2.0 client IDs
# iOS client: bundle id com.atkremke.running-app
# Web client: use this same ID in Supabase → Auth → Google provider
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Dev only: your Supabase auth user UUID — lowers XP min distance to 0.01 mi for this user
# Find in app logs on launch or Supabase → Authentication → Users
EXPO_PUBLIC_DEV_XP_USER_ID=

# RevenueCat public SDK keys — https://app.revenuecat.com/ → Project settings → API keys
# Requires App Store Connect / Google Play products + a RevenueCat "pro" entitlement
# (see src/config/purchases.ts) configured first. Left blank, purchases fail open
# to non-premium rather than crashing.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
